---
import Badge from "../components/Badge.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const highlights = [
  {
    badge: "Where I work",
    title: "Arsenal Football Club",
    text: "I’m a data scientist with a dedicated focus on the Women’s First Team, working across match and opposition analysis, recruitment and player development.",
  },
  {
    badge: "Sports analytics",
    title: "Richmond Hockey Club",
    text: "I am the Men’s 1st Team Performance Analyst, performing both live and post-match analysis in the 2nd tier of the England Hockey League.",
  },
  {
    badge: "Education",
    title: "Imperial College London",
    text: "1st Class (Hons) Master of Engineering. My thesis was in cardiac research, developing deep learning models to classify for arrhythmia-inducing drugs.",
  },
];
const tones = ["primary", "secondary", "accent"] as const;
---

<BaseLayout
  title="About me"
  description="Geoff Sheir is a data scientist at Arsenal, a hockey performance analyst, and an Imperial College London engineering graduate."
>
  <PageHero title="About me" />

  <section class="pb-20 sm:pb-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-8">
      <div class="grid gap-6 md:grid-cols-3">
        {highlights.map(({ badge, title, text }, index) => (
          <article class="reveal rounded-lg border border-line bg-card p-8 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lifted">
            <Badge tone={tones[index % tones.length]}>{badge}</Badge>
            <h2 class="mt-4 mb-3 text-2xl font-semibold">{title}</h2>
            <p class="text-ink-muted">{text}</p>
          </article>
        ))}
      </div>

      <img
        src="https://images.gsheir.com/about_me/geoff.jpg"
        alt="Geoff Sheir"
        class="reveal mx-auto mt-16 w-full max-w-md rounded-lg shadow-card"
        loading="lazy"
      />
    </div>
  </section>
</BaseLayout>
