---
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
const years = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
---

<BaseLayout
  title="Blog"
  description="Football and hockey analysis, coaching reflections, and notes on building software."
>
  <PageHero
    title="Blog"
    subtitle="Football and hockey analysis, coaching reflections, and notes on building software."
  />

  <section class="pb-20 sm:pb-24">
    <div class="mx-auto max-w-4xl space-y-16 px-4 sm:px-8">
      {[...years].map(([year, yearPosts]) => (
        <div>
          <h2 class="mb-6 font-display text-sm font-semibold tracking-widest text-ink-subtle uppercase">{year}</h2>
          <div class="grid gap-6">
            {yearPosts.map((post) => (
              <PostCard post={post} headingLevel="h3" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
