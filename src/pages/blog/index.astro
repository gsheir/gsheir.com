---
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
const years = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
---

<BaseLayout
  title="Blog"
  description="Football and hockey analysis, coaching reflections, and notes on building software."
>
  <PageHero
    title="Blog"
    subtitle="Football and hockey analysis, coaching reflections, and notes on building software."
  />

  <section class="mx-auto max-w-6xl space-y-16 px-5 pb-24 sm:px-8 sm:pb-32">
    {[...years].map(([year, yearPosts]) => (
      <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] sm:gap-8">
        <h2 class="border-t border-rule pt-6 text-base font-medium sm:border-0">{year}</h2>
        <div class="border-b border-rule">
          {yearPosts.map((post) => (
            <PostCard post={post} headingLevel="h3" />
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
