---
import { render } from "astro:content";

import Article from "../../components/Article.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, postMarkdownUrl, postUrl, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1], all: posts },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  all: Post[];
}

const { post, newer, older, all } = Astro.props;
const { title, description, pubDate, updatedDate, series, image } = post.data;
const { Content, headings } = await render(post);
const seriesPosts = series
  ? all
      .filter((other) => other.data.series?.name === series.name)
      .sort((a, b) => a.data.series!.part - b.data.series!.part)
  : [];
const markdownUrl = postMarkdownUrl(post);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Person", name: "Geoffrey Sheir", url: Astro.site?.href },
  url: new URL(postUrl(post), Astro.site).href,
  ...(image && { image }),
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  markdownUrl={markdownUrl}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Article title={title} headings={headings}>
    <a slot="before-title" href="/blog/" class="no-print mb-10 inline-block text-sm text-ink-subtle hover:text-primary">
      ← All posts
    </a>
    <p slot="header" class="flex flex-wrap gap-x-3 border-y border-rule py-3 font-mono text-xs text-ink-subtle">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
      {updatedDate && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated {formatDate(updatedDate)}</span>
        </>
      )}
    </p>

    {seriesPosts.length > 1 && (
      <aside slot="before-content" class="mb-12 border-y border-rule py-5">
        <p class="mb-3 text-sm text-ink-subtle">Part of a series: {series!.name}</p>
        <ol class="space-y-2">
          {seriesPosts.map((part) => (
            <li>
              {part.id === post.id ? (
                <span aria-current="page" class="block border-l-2 border-primary pl-4 font-semibold text-ink">
                  {part.data.title}
                </span>
              ) : (
                <a
                  href={postUrl(part)}
                  class="block border-l-2 border-transparent pl-4 text-ink-muted hover:text-primary"
                >
                  {part.data.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </aside>
    )}

    <div class="prose max-w-none prose-lg">
      <Content />
    </div>

    <nav slot="after-content" aria-label="More posts" class="no-print mt-16 grid border-t border-rule sm:grid-cols-2">
      {older ? (
        <a href={postUrl(older)} class="group border-b border-rule py-5 sm:border-b-0 sm:pr-6">
          <span class="block text-sm text-ink-subtle">← Previous</span>
          <span class="font-medium tracking-[-0.02em] group-hover:text-primary">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {newer && (
        <a href={postUrl(newer)} class="group py-5 sm:border-l sm:border-rule sm:pl-6 sm:text-right">
          <span class="block text-sm text-ink-subtle">Next →</span>
          <span class="font-medium tracking-[-0.02em] group-hover:text-primary">{newer.data.title}</span>
        </a>
      )}
    </nav>
  </Article>
</BaseLayout>
