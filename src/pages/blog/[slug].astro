---
import { render } from "astro:content";

import CopyMarkdown from "../../components/CopyMarkdown.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, postMarkdownUrl, postUrl, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1], all: posts },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  all: Post[];
}

const { post, newer, older, all } = Astro.props;
const { title, description, pubDate, updatedDate, category, series, image } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const seriesPosts = series
  ? all
      .filter((other) => other.data.series?.name === series.name)
      .sort((a, b) => a.data.series!.part - b.data.series!.part)
  : [];
const markdownUrl = postMarkdownUrl(post);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Person", name: "Geoffrey Sheir", url: Astro.site?.href },
  url: new URL(postUrl(post), Astro.site).href,
  ...(image && { image }),
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  markdownUrl={markdownUrl}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="pt-10 pb-24 sm:pt-16 sm:pb-32">
    <div class="mx-auto max-w-3xl px-5 sm:px-8 xl:grid xl:max-w-6xl xl:grid-cols-[minmax(0,48rem)_14rem] xl:justify-between xl:gap-x-16">
      <header class="xl:col-start-1">
        <a href="/blog/" class="no-print mb-10 inline-block text-sm text-ink-subtle hover:text-primary">
          ← All posts
        </a>
        <p class="mb-5 text-sm text-ink-subtle">
          {category}
          {series && (
            <>
              {" "}
              · {series.name}, part {series.part}
            </>
          )}
        </p>
        <h1 class="mb-8 text-4xl leading-[1.05] font-semibold tracking-[-0.045em] sm:text-6xl">{title}</h1>
        <p class="mb-8 flex flex-wrap gap-x-3 border-y border-rule py-3 font-mono text-xs text-ink-subtle">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} min read</span>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
        </p>
        <CopyMarkdown markdownUrl={markdownUrl} />
      </header>

      {toc.length > 1 && (
        <nav aria-label="On this page" class="no-print hidden xl:col-start-2 xl:row-span-2 xl:row-start-1 xl:block">
          <div class="sticky top-8 pt-24">
            <p class="mb-3 text-sm font-medium">On this page</p>
            <ul class="space-y-2 border-l border-line text-sm">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="-ml-px block border-l-2 border-transparent pl-4 text-ink-muted hover:border-primary hover:text-primary"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )}

      <div class="mt-12 xl:col-start-1 xl:row-start-2">
        {seriesPosts.length > 1 && (
          <aside class="mb-12 border-y border-rule py-5">
            <p class="mb-3 text-sm font-medium">Part of a series: {series!.name}</p>
            <ol class="space-y-1">
              {seriesPosts.map((part) => (
                <li>
                  {part.id === post.id ? (
                    <span class="text-ink-subtle">{part.data.title}</span>
                  ) : (
                    <a href={postUrl(part)} class="font-medium hover:text-primary">
                      {part.data.title}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </aside>
        )}

        <div class="prose max-w-none prose-lg">
          <Content />
        </div>

        <nav aria-label="More posts" class="no-print mt-16 grid border-t border-rule sm:grid-cols-2">
          {older ? (
            <a href={postUrl(older)} class="group border-b border-rule py-5 sm:border-b-0 sm:pr-6">
              <span class="block text-sm text-ink-subtle">← Previous</span>
              <span class="font-medium tracking-[-0.02em] group-hover:text-primary">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={postUrl(newer)} class="group py-5 sm:border-l sm:border-rule sm:pl-6 sm:text-right">
              <span class="block text-sm text-ink-subtle">Next →</span>
              <span class="font-medium tracking-[-0.02em] group-hover:text-primary">{newer.data.title}</span>
            </a>
          )}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
