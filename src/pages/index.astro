---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPosts, postUrl, readingTime } from "../lib/posts";
import { site } from "../lib/site";

const posts = await getPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const sectionGrid = "grid gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] sm:gap-8";
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8 sm:pb-28">
    <h1 class="display -ml-[0.05em] pt-8 pb-10 text-[clamp(4rem,14.5vw,10.5rem)] sm:pt-12 sm:pb-14">
      Geoffrey
      <br />
      Sheir
    </h1>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] md:gap-8">
      <div class="grid content-start gap-6 sm:gap-8">
        <p class="max-w-[22ch] text-[clamp(1.5rem,3.2vw,2.4rem)] leading-[1.15] tracking-[-0.03em]">
          Full stack data scientist, engineer, and sports performance analyst.
        </p>
        <a href="/about/" class="justify-self-start font-medium hover:text-primary">
          About me →
        </a>
      </div>
      <img
        src="https://images.gsheir.com/about_me/prem_trophy.jpg"
        alt="Geoffrey Sheir with the Premier League trophy"
        class="aspect-square w-full max-w-sm object-cover md:max-w-none"
        width="600"
        height="600"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="bg-panel py-16 text-on-panel sm:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 class="display mb-10 text-[clamp(3rem,9vw,6.5rem)] sm:mb-14">Featured analysis</h2>
      <div class="grid gap-10 md:grid-cols-3 md:gap-8">
        {featured.map((post) => (
          <article class="group relative grid content-start gap-3 border-t border-on-panel/60 pt-4">
            <p class="font-mono text-xs">
              {formatDate(post.data.pubDate, "short")} · {readingTime(post.body)} min
            </p>
            <h3 class="text-xl leading-snug font-medium tracking-[-0.025em] sm:text-2xl">
              <a
                href={postUrl(post)}
                class="decoration-2 underline-offset-4 after:absolute after:inset-0 group-hover:underline"
              >
                {post.data.title}
              </a>
            </h3>
            <p class="text-on-panel/75">{post.data.description}</p>
          </article>
        ))}
      </div>
      <a href="/blog/" class="mt-12 inline-block decoration-2 underline-offset-4 hover:underline">
        All posts →
      </a>
    </div>
  </section>

  <section class:list={["mx-auto max-w-6xl px-5 pt-20 sm:px-8 sm:pt-28", sectionGrid]}>
    <h2 class="text-base font-medium">Projects</h2>
    <div class="grid items-baseline gap-2 border-y border-rule py-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_auto] sm:gap-8">
      <h3 class="text-2xl font-semibold tracking-[-0.03em]">XML Translator</h3>
      <p class="text-ink-muted">A tool to translate hockey XML event data.</p>
      <a href="https://xml.gsheir.com" class="hover:text-primary">
        xml.gsheir.com ↗
      </a>
    </div>
  </section>

  <section id="contact" class:list={["mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28", sectionGrid]}>
    <h2 class="text-base font-medium">Let’s chat</h2>
    <ul class="flex flex-wrap gap-x-[5vw] gap-y-2">
      <li>
        <a href={site.links.github} class="display text-[clamp(3rem,8.5vw,6rem)] hover:text-primary">
          GitHub ↗
        </a>
      </li>
      <li>
        <a href={site.links.linkedin} class="display text-[clamp(3rem,8.5vw,6rem)] hover:text-primary">
          LinkedIn ↗
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
