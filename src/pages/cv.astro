---
import { getEntry, render } from "astro:content";

import Article from "../components/Article.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const cv = await getEntry("pages", "cv");
if (!cv) throw new Error("Missing src/content/pages/cv.md");
const { Content, headings } = await render(cv);
---

<BaseLayout title={cv.data.title} description={cv.data.description} markdownUrl="/cv.md">
  <Article title={cv.data.title} headings={headings} class="cv-page">
    <p slot="header" class="no-print border-y border-rule py-3 text-sm">
      <button type="button" onclick="window.print()" class="cursor-pointer font-medium hover:text-primary">
        Print or save as PDF
      </button>
    </p>
    <div class="cv prose max-w-none prose-lg">
      <h2 class="mt-0!">{cv.data.name}</h2>
      {cv.data.summary && <p class="lead">{cv.data.summary}</p>}
      <Content />
    </div>
  </Article>
</BaseLayout>

<style>
  .cv :global(h3 + p > em:only-child) {
    color: var(--ink-subtle);
    font-size: 0.9em;
  }

  @media print {
    :global(body) {
      font-size: 11pt;
      background: white;
    }
    :global(.cv-page header) {
      display: none;
    }
    :global(.cv-page) {
      padding-top: 0;
    }
  }
</style>
