---
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line bg-surface-alt">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-10 text-sm text-ink-subtle sm:flex-row sm:px-8">
    <p>
      &copy; {year} {site.name}
    </p>
    <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
      <li>
        <a class="transition hover:text-primary" href={site.links.github}>
          GitHub
        </a>
      </li>
      <li>
        <a class="transition hover:text-primary" href={site.links.linkedin}>
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</footer>
