---
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="no-print mx-auto w-full max-w-6xl px-5 sm:px-8">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-rule py-5 text-sm text-ink-subtle">
    <p>
      &copy; {year} {site.name}
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li>
        <a class="hover:text-primary" href={site.links.github}>
          GitHub
        </a>
      </li>
      <li>
        <a class="hover:text-primary" href={site.links.linkedin}>
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</footer>
