---
interface Props {
  tone?: "primary" | "secondary" | "accent";
}

const { tone = "primary" } = Astro.props;

const tones = {
  primary: "bg-crimson-500/10 text-primary",
  secondary: "bg-lilac-500/15 text-lilac-600 dark:text-lilac-300",
  accent: "bg-sky-500/15 text-sky-700 dark:text-sky-300",
};
---

<span class:list={["inline-block rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase", tones[tone]]}>
  <slot />
</span>
