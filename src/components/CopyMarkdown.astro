---
interface Props {
  markdownUrl: string;
}

const { markdownUrl } = Astro.props;
const buttonClass =
  "inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-rule px-3.5 py-1.5 text-sm font-medium hover:border-primary hover:bg-primary hover:text-surface";
---

<div class="no-print flex flex-wrap items-center gap-2" data-copy-markdown={markdownUrl}>
  <button type="button" class={buttonClass} data-copy-button>
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span data-copy-label>Copy as Markdown</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-copy-markdown]").forEach((container) => {
    const button = container.querySelector<HTMLButtonElement>("[data-copy-button]");
    const label = container.querySelector<HTMLElement>("[data-copy-label]");
    if (!button || !label) return;

    button.addEventListener("click", async () => {
      const original = label.textContent;
      try {
        const markdown = fetch(container.dataset.copyMarkdown!).then((response) => {
          if (!response.ok) throw new Error(response.statusText);
          return response.text();
        });
        // Passing a promise keeps the clipboard write inside the click's user activation in Safari.
        await navigator.clipboard.write([
          new ClipboardItem({ "text/plain": markdown.then((text) => new Blob([text], { type: "text/plain" })) }),
        ]);
        label.textContent = "Copied!";
      } catch {
        label.textContent = "Copy failed";
      }
      setTimeout(() => (label.textContent = original), 2000);
    });
  });
</script>
