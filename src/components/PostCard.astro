---
import { formatDate, postUrl, readingTime, type Post } from "../lib/posts";

interface Props {
  post: Post;
  showDate?: boolean;
  headingLevel?: "h2" | "h3";
}

const { post, showDate = true, headingLevel: Heading = "h3" } = Astro.props;
const { title, description, category, pubDate } = post.data;
---

<article
  class:list={[
    "group relative grid gap-2 border-t border-rule py-6",
    showDate && "sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-8",
  ]}
>
  {showDate && (
    <time datetime={pubDate.toISOString()} class="font-mono text-xs text-ink-subtle sm:pt-2">
      {formatDate(pubDate, "short")}
    </time>
  )}
  <div>
    <Heading class="text-xl leading-snug font-medium tracking-[-0.025em] sm:text-2xl">
      <a href={postUrl(post)} class="after:absolute after:inset-0 group-hover:text-primary">
        {title}
      </a>
    </Heading>
    <p class="mt-2 text-ink-muted">{description}</p>
    <p class="mt-3 text-sm text-ink-subtle">
      {category} · {readingTime(post.body)} min read
    </p>
  </div>
</article>
