---
import { formatDate, postUrl, readingTime, type Post } from "../lib/posts";
import Badge from "./Badge.astro";

interface Props {
  post: Post;
  showDate?: boolean;
  headingLevel?: "h2" | "h3";
}

const { post, showDate = true, headingLevel: Heading = "h3" } = Astro.props;
const { title, description, category, pubDate, series } = post.data;
---

<article class="reveal group relative flex h-full flex-col rounded-lg border border-line bg-card p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lifted sm:p-8">
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <Badge>{category}</Badge>
    {series && <Badge tone="secondary">Part {series.part}</Badge>}
  </div>
  <Heading class="mb-3 text-xl font-semibold text-ink sm:text-2xl">
    <a href={postUrl(post)} class="after:absolute after:inset-0 group-hover:text-primary">
      {title}
    </a>
  </Heading>
  <p class="mb-6 flex-1 text-ink-muted">{description}</p>
  <p class="flex items-center justify-between text-sm text-ink-subtle">
    {showDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
    <span>{readingTime(post.body)} min read</span>
  </p>
</article>
