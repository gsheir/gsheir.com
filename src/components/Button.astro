---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "secondary" | "accent";
}

const { variant = "primary", class: className, ...rest } = Astro.props;

const variants = {
  primary: "bg-crimson-500 text-white shadow-card hover:bg-crimson-600 hover:shadow-lifted",
  secondary: "border-2 border-primary text-primary hover:bg-primary hover:text-white",
  accent: "bg-sky-500 text-white shadow-card hover:bg-sky-600 hover:shadow-lifted",
};
---

<a
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 font-semibold no-underline transition duration-300 hover:-translate-y-0.5",
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
