---
import { site } from "../lib/site";
import ThemeToggle from "./ThemeToggle.astro";

const current = Astro.url.pathname;
---

<header class="no-print fixed inset-x-0 top-0 z-50 border-b border-line bg-glass backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3 sm:px-8" aria-label="Main">
    <a href="/" class="font-display text-2xl font-bold text-primary transition hover:text-primary-strong dark:text-ink">
      {site.shortName}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center gap-0.5 sm:gap-2">
        {site.nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={current.startsWith(href) ? "page" : undefined}
              class="rounded-full px-2.5 py-2 text-[15px] font-medium text-ink transition hover:bg-primary/10 hover:text-primary aria-[current=page]:text-primary sm:px-4 sm:text-base"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
