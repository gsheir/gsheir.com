---
import { site } from "../lib/site";
import ThemeToggle from "./ThemeToggle.astro";

const current = Astro.url.pathname;
---

<header class="no-print">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8" aria-label="Main">
    <a href="/" class="text-lg font-semibold tracking-[-0.03em] hover:text-primary">
      {site.shortName}
    </a>
    <div class="flex items-center gap-3 sm:gap-6">
      <ul class="flex items-center gap-4 text-[15px] sm:gap-7">
        {site.nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={current.startsWith(href) ? "page" : undefined}
              class="hover:text-primary aria-[current=page]:text-primary"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
