---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden pt-32 pb-12 sm:pt-40 sm:pb-16">
  <div class="bg-hero-glow absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-4 text-center sm:px-8">
    <h1 class="text-gradient animate-fade-up pb-2 text-5xl font-extrabold tracking-tight sm:text-7xl">{title}</h1>
    {subtitle && (
      <p class="animate-fade-up mx-auto mt-4 max-w-2xl text-lg text-ink-muted [animation-delay:150ms]">{subtitle}</p>
    )}
    <slot />
  </div>
</section>
