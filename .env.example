# Local Development Environment Variables
# Copy from .env.example and modify for local development

# Core Django Settings
SECRET_KEY=django-insecure-local-development-key-change-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Local development settings
RAILWAY_ENVIRONMENT=
RAILWAY_STATIC_URL=
LOG_LEVEL=INFO
CSRF_TRUSTED_ORIGINS=http://localhost:8080
