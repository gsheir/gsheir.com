{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Legacy Django URLs, generated at build time from src/redirects.ts
	import /etc/caddy/redirects.caddy

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"

	@text path /llms.txt /llms-full.txt /robots.txt
	header @text Content-Type "text/plain; charset=utf-8"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
